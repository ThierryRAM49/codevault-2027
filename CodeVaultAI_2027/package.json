{
  "name": "codevault-ai",
  "version": "1.0.0",
  "description": "Assistant IA sécurisé local pour gérer et analyser vos snippets de code.",
  "author": "Th_RAMANITRA",
  "main": "electron-main/main.js",
  "scripts": {
    "dev": "electron .",
    "build": "electron-builder"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "electron-store": "^8.1.0",
    "i18next": "^23.7.19",
    "monaco-editor": "^0.55.1",
    "react-i18next": "^14.0.5",
    "sqlite3": "^5.1.6"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.13.3",
    "electron-rebuild": "^3.2.9",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwindcss": "^3.4.0",
    "webpack": "^5.90.0"
  },
  "build": {
    "appId": "com.codevaultai.app",
    "productName": "CodeVaultAI 2027",
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "icon": "assets/icon.png"
    },
    "files": [
      "**/*",
      "!src/data/*",
      "!dist/*"
    ],
    "directories": {
      "output": "dist"
    }
  }
}
